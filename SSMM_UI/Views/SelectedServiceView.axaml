<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="400"
		Width="520"
		Height="620"
		MinWidth="420"
		MinHeight="500"
		x:Class="SSMM_UI.Views.SelectedServiceView"
		xmlns:local="clr-namespace:SSMM_UI.ViewModel"
		xmlns:rtmp="clr-namespace:SSMM_UI.RTMP" 
		x:DataType="local:SelectedServiceViewModel"
		Icon="avares://MultistreamManager/Assets/MainIcon.png"
		Title="{Binding ViewedService.DisplayName}">
	<ScrollViewer HorizontalScrollBarVisibility="Disabled">
	<StackPanel Margin="14" Spacing="10">

		<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">

			<TextBlock Grid.Row="0" Grid.Column="0"
					   Text="Server:"
					   VerticalAlignment="Center" Margin="0,0,8,0"/>
			<TextBlock Grid.Row="0" Grid.Column="1"
					   Text="{Binding DisplayName}"
					   VerticalAlignment="Center"/>

			<TextBlock Grid.Row="1" Grid.Column="0"
					   Text="StreamKey:"
					   VerticalAlignment="Center" Margin="0,0,8,0"/>
			<Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
				<TextBox Grid.Column="0"
						 Text="{Binding StreamKey}"
						 MinWidth="220"
						 PasswordChar="•"
						 RevealPassword="{Binding IsStreamKeyVisible}"/>
				<Button Grid.Column="1"
						Content="{Binding StreamKeyVisibilityText}"
						Command="{Binding ToggleStreamKeyVisibilityCommand}"/>
			</Grid>
			<CheckBox  Grid.Row="3" Content="Enabled" IsChecked="{Binding IsActive}"/>
		</Grid>
		<Button Command="{Binding ShowServers}" Content="Change Server"/>
		<ListBox x:Name="RTMPServerList"
				 ItemsSource="{Binding ServiceGroup.Servers}"
				 SelectedItem="{Binding SelectedServer, Mode=TwoWay}"
				 IsVisible="{Binding ShowServerList}"
				 Margin="0" MinHeight="220">
			<ListBox.ItemTemplate>
				<DataTemplate x:DataType="rtmp:RtmpServerInfo">
					<TextBlock Text="{Binding ServerName}"/>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" HorizontalAlignment="Center">
		<Button Command="{Binding SaveCMD}" Grid.Row="0" Grid.Column="0" Classes="success" Content="Save"/>
		<Button Command="{Binding CancelCMD}" Grid.Row="0" Grid.Column="1" Classes="danger" Content="Cancel"/>
		</Grid>
			<Button DockPanel.Dock="Bottom" Content="Delete" Width="180" HorizontalAlignment="Center" Classes="danger" Margin="0 5 0 0"
						Command="{Binding RemoveSelectedServiceCommand}"/>
		
	</StackPanel>
	</ScrollViewer>
</Window>
