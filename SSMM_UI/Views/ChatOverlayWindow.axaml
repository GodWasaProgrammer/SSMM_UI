<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SSMM_UI.ViewModel"
        xmlns:views="clr-namespace:SSMM_UI.Views"
        mc:Ignorable="d"
        x:Class="SSMM_UI.Views.ChatOverlayWindow"
        x:DataType="vm:ChatOverlayViewModel"
        Width="700"
        Height="560"
        MinWidth="420"
        MinHeight="320"
        SystemDecorations="None"
        Background="Transparent"
        Opacity="{Binding OverlayOpacity}"
        Topmost="{Binding IsAlwaysOnTop}"
        TransparencyLevelHint="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        CanResize="True"
        ShowInTaskbar="False"
        KeyDown="OnKeyDown"
        Title="Chat Overlay">
    <views:ChatOverlayView />
</Window>
