<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SSMM_UI.Views"
             xmlns:vm="clr-namespace:SSMM_UI.ViewModel"
             x:Class="SSMM_UI.Views.LogView"
             x:DataType="vm:LogViewModel"
             MinHeight="0">

	<Grid RowDefinitions="Auto,*,*"
          RowSpacing="8"
          MinHeight="0">

		<!-- LOG HEADER -->

		<TextBlock Grid.Row="0"
                   Text="LOGS"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSubtleBrush}"/>


		<!-- LOG -->

		<Border Grid.Row="1"
                MinHeight="0"
                Background="{DynamicResource InputBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="7"
                ClipToBounds="True">

			<ListBox ItemsSource="{Binding LogMessages}"
                     SelectedItem="{Binding SelectedLogItem}"
                     FontFamily="Consolas, 'Courier New'"
                     FontSize="11"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="8"
                     MinHeight="0"/>

		</Border>


		<!-- OUTPUTS -->

		<views:OutputDisplayView
            Grid.Row="2"
            DataContext="{Binding StreamOutputVM}"
            MinHeight="0"/>

	</Grid>

</UserControl>
