<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="250"
	         xmlns:local="clr-namespace:SSMM_UI.ViewModel"
	         xmlns:Views="clr-namespace:SSMM_UI.Views"
			 x:DataType="local:OutputViewModel"
             x:Class="SSMM_UI.Views.OutPutView">

	<Grid RowDefinitions="Auto,Auto" MinHeight="0">

		<Border Classes="card" Margin="0 0 12 0">
			<StackPanel Spacing="8">
				<TextBlock Text="{Binding Header}"></TextBlock>
				<ListBox
						ItemsSource="{Binding LogMessages}"
						 SelectedItem="{Binding SelectedMessage}"
						 Height="220"
						 MinWidth="280"
						 FontFamily="Consolas, Courier New"
						 BorderThickness="0"
						 Padding="10"
				Opacity="1"/>
				<Button
					Content="Restart"
					Command="{Binding RestartProcessCMD}"
					HorizontalAlignment="Left"/>
			</StackPanel>
		</Border>
	</Grid>
</UserControl>
