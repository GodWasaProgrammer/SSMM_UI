<Window xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	x:Class="SSMM_UI.MainWindow"
	xmlns:local="clr-namespace:SSMM_UI.ViewModel"
	xmlns:settings="clr-namespace:SSMM_UI.Settings"
	xmlns:Views="clr-namespace:SSMM_UI.Views"
	x:DataType="local:MainWindowViewModel"

	Title="Multistream Manager"
	Width="1920"
	Height="1080"
	MinWidth="1120"
	MinHeight="700"

	Background="{DynamicResource AppBackgroundBrush}"
	Icon="avares://MultistreamManager/Assets/MainIcon.png">


	<Grid RowDefinitions="Auto,*">


		<!-- =====================================================
             TOP BAR
             ===================================================== -->

		<Border Grid.Row="0"
                Background="{DynamicResource MenuBackgroundBrush}"
                BorderBrush="{DynamicResource MenuBorderBrush}"
                BorderThickness="1"
                CornerRadius="7"
                Padding="7 5"
                Margin="0 0 0 8">

			<Grid ColumnDefinitions="Auto,*,Auto">

				<!-- Main menu -->

				<Menu Grid.Column="1"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center">

					<MenuItem Header="Settings"
                              Command="{Binding OpenSetting}"
                              ToolTip.Tip="Open application preferences."/>

					<MenuItem Header="Get Started"
                              Command="{Binding OpenGettingStarted}"
                              ToolTip.Tip="Open step-by-step onboarding guide."/>

					<MenuItem Header="Chat Overlay"
                              Command="{Binding OpenChatOverlay}"
                              ToolTip.Tip="Open aggregated chat overlay window."/>

					<MenuItem Header="Setup">

						<MenuItem Header="YouTube"
                                  Command="{Binding SetupPuppetYT}"
                                  ToolTip.Tip="Prepare YouTube browser profile/session."/>

						<MenuItem Header="Kick"
                                  Command="{Binding SetupPuppetKick}"
                                  ToolTip.Tip="Prepare Kick browser profile/session."/>

						<MenuItem Header="Webhooks"
                                  Command="{Binding ShowSecretsAndKeys}"
                                  ToolTip.Tip="Open webhook and secret management window."/>

					</MenuItem>

					<MenuItem Header="About"
                              Command="{Binding OpenAbout}"
                              ToolTip.Tip="Show application and author information."/>

					<MenuItem Header="Tokens">

						<MenuItem Header="Purge All Auth Tokens"
                                  Command="{Binding DeleteAllTokens}"
                                  ToolTip.Tip="Delete all stored authentication tokens."/>

						<MenuItem Header="Purge Specific Token"
                                  Command="{Binding DeleteSpecifiedTokenCmd}"
                                  ToolTip.Tip="Delete one selected provider token."/>

					</MenuItem>

				</Menu>


				<!-- Theme -->

				<StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="7"
                            VerticalAlignment="Center">

					<TextBlock Text="Theme"
                               FontSize="12"
                               Foreground="{DynamicResource TextSubtleBrush}"
                               VerticalAlignment="Center"/>

					<ComboBox Width="150"
                              Height="30"
                              ItemsSource="{Binding Themes}"
                              SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                              ToolTip.Tip="Switch the active UI theme.">

						<ComboBox.ItemTemplate>

							<DataTemplate x:DataType="settings:ThemeOption">

								<TextBlock Text="{Binding Name}"/>

							</DataTemplate>

						</ComboBox.ItemTemplate>

					</ComboBox>

				</StackPanel>

			</Grid>

		</Border>


		<!-- =====================================================
             MAIN WORKSPACE
             ===================================================== -->

		<Grid Grid.Row="1"
              ColumnDefinitions="270,1,*,1,200">


			<!-- =================================================
                 LEFT SIDEBAR
                 ================================================= -->

			<Border Grid.Column="0"
                    Background="{DynamicResource SurfaceOverlayBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="8">

				<Views:LeftSideBarView x:Name="LeftSideBar"
                                       DataContext="{Binding LeftSideBarVM}"/>

			</Border>


			<!-- LEFT SEPARATOR -->

			<Border Grid.Column="1"
                    Background="{DynamicResource CardBorderBrush}"
                    Margin="4 8"/>


			<!-- =================================================
                 MAIN CONTENT
                 ================================================= -->

			<Grid Grid.Column="2"
                  Margin="10 0">

				<TabControl Background="Transparent"
                            BorderThickness="0"
                            Padding="0">

					<!-- STREAM -->

					<TabItem Header="Stream">

						<Grid RowDefinitions="*,Auto"
                              RowSpacing="8">

							<Views:StreamControlView
                                Grid.Row="0"
                                DataContext="{Binding StreamControlVM}"/>

							<Views:LogView
                                Grid.Row="1"
                                DataContext="{Binding LogVM}"/>

						</Grid>

					</TabItem>


					<!-- METADATA -->

					<TabItem Header="Stream Metadata">

						<Views:MetaDataView
                            DataContext="{Binding MetaDataVM}"/>

					</TabItem>


					<!-- SOCIAL -->

					<TabItem Header="Social Media AutoPoster">

						<Views:SocialPosterView
                            DataContext="{Binding SocialPosterVM}"/>

					</TabItem>

				</TabControl>

			</Grid>


			<!-- RIGHT SEPARATOR -->

			<Border Grid.Column="3"
                    Background="{DynamicResource CardBorderBrush}"
                    Margin="4 8"/>


			<!-- =================================================
                 RIGHT SIDEBAR
                 ================================================= -->

			<Border Grid.Column="4"
                    Background="{DynamicResource SurfaceOverlayBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="8">

				<ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">

					<StackPanel Spacing="8">

						<Views:LoginView
                            DataContext="{Binding LoginVM}"/>

						<Views:SocialPosterLoginView
                            DataContext="{Binding SocialPosterLoginVM}"/>

						<Views:InspectionView
                            x:Name="Preview"
                            DataContext="{Binding InspectionVM}"/>

					</StackPanel>

				</ScrollViewer>

			</Border>

		</Grid>

	</Grid>

</Window>
